---
import { ThemeSelect, themeScript } from './_lib'
import './_style.css'
---
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width,initial-scale=1'
    />
    <title>Resonare Demo</title>
    <meta
      name='content'
      content='#fff'
      media='(prefers-color-scheme: light)'
    />
    <meta
      name='content'
      content='#000'
      media='(prefers-color-scheme: dark)'
    />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <main>
      <h1>resonare</h1>
      <h2>A state store for multi-dimensional themes and user preferences.</h2>
      <a
        href='https://github.com/phuoccss/resonare'
        rel='noopener noreferrer'
        target='_blank'
      >
        Documentation <span aria-hidden='true'>→</span>
      </a>
      <ThemeSelect client:load />
    </main>
  </body>
</html>
